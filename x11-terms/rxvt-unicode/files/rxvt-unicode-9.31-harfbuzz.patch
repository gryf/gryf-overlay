+  if (ncp < 2)
+    return false;
+
+  int fid = fs->find_shaping_font (cluster, ncp);
+
+  if (fid < 0)
+    return false;
+
+  for (int i = s; i < s + cells && i < ncol; i++)
+    l.r[i] = SET_FONT (l.r[i], fid);
+
+  return true;
+}
