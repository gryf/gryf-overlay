+static bool
+needs_harfbuzz_shaping (uint32_t chr)
+{
+  if (chr >= 0x1F000 && chr <= 0x1F9FF) return true;
+  if (chr >= 0x1F300 && chr <= 0x1F5FF) return true;
+  if (chr >= 0x1F600 && chr <= 0x1F64F) return true;
+  if (chr >= 0x1F680 && chr <= 0x1F6FF) return true;
+  if (chr >= 0x1F700 && chr <= 0x1F77F) return true;
+  if (chr >= 0x1F780 && chr <= 0x1F7FF) return true;
+  if (chr >= 0x1F800 && chr <= 0x1F8FF) return true;
+  if (chr >= 0x1F900 && chr <= 0x1F9FF) return true;
+  if (chr >= 0x2600 && chr <= 0x27BF) return true;
+  if (chr >= 0x2300 && chr <= 0x23FF) return true;
+
+  if (chr >= 0xFE00 && chr <= 0xFE0F) return true;
+  if (chr >= 0xE0100 && chr <= 0xE01EF) return true;
+
+  if (chr == 0x200D) return true;
+
+  if (chr >= 0x0300 && chr <= 0x036F) return true;
+
+  if (chr >= 0x20D0 && chr <= 0x20FF) return true;
+
+  return false;
+}
+
+static void
+rxvt_hb_shape (hb_font_t *hb_font, const uint32_t *chars, int len,
+               hb_glyph_info_t *&glyph_info, hb_glyph_position_t *&glyph_pos,
+               unsigned int &glyph_count)
+{
+  glyph_count = 0;
+  glyph_info = NULL;
+  glyph_pos = NULL;
+
+  hb_buffer_t *buf = hb_buffer_create ();
+  if (!buf)
+    return;
+
+  hb_buffer_add_utf32 (buf, chars, len, 0, len);
+  hb_buffer_set_content_type (buf, HB_BUFFER_CONTENT_TYPE_UNICODE);
+  hb_buffer_guess_segment_properties (buf);
+
+  hb_shape (hb_font, buf, NULL, 0);
+
+  glyph_count = hb_buffer_get_length (buf);
+
+  if (glyph_count > 0)
+    {
+      hb_glyph_info_t *tmp_info = hb_buffer_get_glyph_infos (buf, NULL);
+      hb_glyph_position_t *tmp_pos = hb_buffer_get_glyph_positions (buf, NULL);
+
+      if (tmp_info && tmp_pos)
+        {
+          glyph_info = (hb_glyph_info_t *)malloc (glyph_count * sizeof (hb_glyph_info_t));
+          glyph_pos = (hb_glyph_position_t *)malloc (glyph_count * sizeof (hb_glyph_position_t));
+
+          memcpy (glyph_info, tmp_info, glyph_count * sizeof (hb_glyph_info_t));
+          memcpy (glyph_pos, tmp_pos, glyph_count * sizeof (hb_glyph_position_t));
+        }
+    }
+
+  hb_buffer_destroy (buf);
+}
+
+static int
+hb_expand_cell (text_t t, uint32_t *out, int out_max)
+{
+#if ENABLE_COMBINING
+  if (IS_COMPOSE (t))
+    {
+      if (rxvt_composite.expand (t) > HB_CLUSTER_MAX)
+        return 0;
+
+      text_t tmp [HB_CLUSTER_MAX];
+      int n = rxvt_composite.expand (t, tmp);
+
+      if (n > out_max)
+        n = out_max;
+
+      for (int i = 0; i < n; i++)
+        out [i] = tmp [i];
+
+      return n;
+    }
+#endif
+
+  if (out_max < 1)
+    return 0;
+
+  out [0] = t;
+  return 1;
+}
+
+int
+hb_build_cluster (const text_t *text, int len, uint32_t *out, int &cells)
+{
+  int ncp = hb_expand_cell (*text, out, HB_CLUSTER_MAX);
+  int c = 1;
+
+  cells = 1;
+
+  if (ncp < 1)
+    return 0;
+
+  while (c < len && ncp < HB_CLUSTER_MAX)
+    {
+      if (text [c] == NOCHAR)
+        {
+          c++;
+          continue;
+        }
+
+      uint32_t next [HB_CLUSTER_MAX];
+      int nn = hb_expand_cell (text [c], next, HB_CLUSTER_MAX);
+
+      if (nn < 1)
+        break;
+
+      bool join = out [ncp - 1] == 0x200D
+                  || next [0] == 0x200D
+                  || (next [0] >= 0x1F3FB && next [0] <= 0x1F3FF)
+                  || (next [0] >= 0xFE00  && next [0] <= 0xFE0F)
+                  || (ncp == 1
+                      && out [0]  >= 0x1F1E6 && out [0]  <= 0x1F1FF
+                      && next [0] >= 0x1F1E6 && next [0] <= 0x1F1FF);
+
+      if (!join)
+        break;
+
+      if (ncp + nn > HB_CLUSTER_MAX)
+        break;
+
+      for (int i = 0; i < nn; i++)
+        out [ncp++] = next [i];
+
+      c++;
+      cells = c;
+    }
+
+  while (cells < len && text [cells] == NOCHAR)
+    cells++;
+
+  return ncp;
+}
+
+bool
+rxvt_font_xft::shape_to_glyph (const uint32_t *cp, int ncp, uint32_t &glyph)
+{
+  if (!hb.hb_font)
+    return false;
+
+  shape_cache_entry *e = 0;
+
+  if (ncp >= 1 && ncp <= shape_cache_ncp_max)
+    {
+      if (!shape_cache)
+        shape_cache = (shape_cache_entry *)
+                        rxvt_calloc (shape_cache_size, sizeof (shape_cache_entry));
+
+      e = shape_cache + (shape_cache_hash (cp, ncp) & (shape_cache_size - 1));
+
+      if (e->ncp == ncp && !memcmp (e->cp, cp, ncp * sizeof (uint32_t)))
+        {
+          if (e->ok)
+            glyph = e->glyph;
+
+          return e->ok;
+        }
+    }
+
+  hb_glyph_info_t *gi = NULL;
+  hb_glyph_position_t *gp = NULL;
+  unsigned int gc = 0;
+
+  rxvt_hb_shape (hb.hb_font, cp, ncp, gi, gp, gc);
+
+  bool ok = gc == 1 && gi && gp && gi [0].codepoint;
+
+  if (ok)
+    glyph = gi [0].codepoint;
+
+  free (gi);
+  free (gp);
+
+  if (e)
+    {
+      e->ncp   = ncp;
+      e->ok    = ok;
+      e->glyph = ok ? glyph : 0;
+      memcpy (e->cp, cp, ncp * sizeof (uint32_t));
+    }
+
+  return ok;
+}
+
+rxvt_fontset::shape_font_entry *
+rxvt_fontset::shape_cache_find (const uint32_t *cp, int ncp) const
+{
+  if (!shape_cache_mask)
+    return 0;
+
+  uint32_t p = shape_cache_hash (cp, ncp) & shape_cache_mask;
+
+  while (shape_cache [p].ncp)
+    {
+      const shape_font_entry &e = shape_cache [p];
+
+      if (e.ncp == ncp && !memcmp (e.cp, cp, ncp * sizeof (uint32_t)))
+        return shape_cache + p;
+
+      p = (p + 1) & shape_cache_mask;
+    }
+
+  return 0;
+}
+
+void
+rxvt_fontset::shape_cache_grow ()
+{
+  uint32_t old_size = shape_cache_mask ? shape_cache_mask + 1 : 0;
+  shape_font_entry *old = shape_cache;
+
+  uint32_t size = old_size ? old_size * 2 : 256;
+
+  shape_cache = (shape_font_entry *)rxvt_calloc (size, sizeof (shape_font_entry));
+  shape_cache_mask = size - 1;
+
+  for (uint32_t i = 0; i < old_size; i++)
+    if (old [i].ncp)
+      {
+        uint32_t p = shape_cache_hash (old [i].cp, old [i].ncp) & shape_cache_mask;
+
+        while (shape_cache [p].ncp)
+          p = (p + 1) & shape_cache_mask;
+
+        shape_cache [p] = old [i];
+      }
+
+  free (old);
+}
+
+void
+rxvt_fontset::shape_cache_insert (const uint32_t *cp, int ncp, int fid)
+{
+  if (shape_cache_used >= shape_cache_max)
+    return;
+
+
+  // keep the load factor at or below 1/2
+  if ((shape_cache_used + 1) * 2 > shape_cache_mask)
+    shape_cache_grow ();
+
+  uint32_t p = shape_cache_hash (cp, ncp) & shape_cache_mask;
+
+  while (shape_cache [p].ncp)
+    p = (p + 1) & shape_cache_mask;
+
+  shape_cache [p].ncp = ncp;
+  shape_cache [p].fid = fid;
+  memcpy (shape_cache [p].cp, cp, ncp * sizeof (uint32_t));
+
+  shape_cache_used++;
+}
+
+void
+rxvt_fontset::shape_cache_flush ()
+{
+  if (shape_cache_used)
+
+  free (shape_cache);
+  shape_cache = 0;
+  shape_cache_mask = 0;
+  shape_cache_used = 0;
+}
+
+int
+rxvt_fontset::find_shaping_font (const uint32_t *cp, int ncp)
+{
+  bool cacheable = ncp >= 1 && ncp <= shape_cache_ncp_max;
+
+  if (cacheable)
+    if (shape_font_entry *e = shape_cache_find (cp, ncp))
+      {
+        return e->fid;
+      }
+
+  find_font_idx (cp [0]);
+
+  int fid = -1;
+
+  unsigned int last = min<unsigned int> (fonts.size (), fontCount);
+
+  for (unsigned int i = firstFont; i < last; i++)
+    {
+      uint32_t glyph;
+
+      if (fonts [i] && fonts [i]->shape_to_glyph (cp, ncp, glyph))
+        {
+          fid = i << 1;
+          break;
+        }
+    }
+
+  if (cacheable)
+    shape_cache_insert (cp, ncp, fid);
+
+  return fid;
+}
