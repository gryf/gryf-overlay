+
+static bool
+scr_emoji_continues (text_t *tp, text_t *start, unicode_t c)
+{
+  bool joiner = c == 0x200D || IN_RANGE_INC (c, 0xFE00, 0xFE0F);
+  bool skin   = IN_RANGE_INC (c, 0x1F3FB, 0x1F3FF);
+
+  if (!joiner && !skin && !IS_EMOJI_BASE (c))
+    return false;
+
+  while (*tp == NOCHAR && tp > start)
+    tp--;
+
+  compose_char *pcc = rxvt_composite [*tp];
+
+  if (pcc && pcc->c2 == 0x200D)
+    return true;
+
+  return (joiner || skin) && IS_EMOJI_BASE (scr_cell_base (*tp));
+}
+
+static bool
+scr_group_emoji (line_t &l, int col, int ncol, rxvt_fontset *fs)
+{
+  int s = col;
+
+  while (s > 0)
+    {
+      int p = s - 1;
+
+      while (p > 0 && l.t[p] == NOCHAR)
+        p--;
+
+      compose_char *pcc = rxvt_composite [l.t[p]];
+
+      if (!((pcc && pcc->c2 == 0x200D)
+            || IN_RANGE_INC (scr_cell_base (l.t[s]), 0x1F3FB, 0x1F3FF)))
+        break;
